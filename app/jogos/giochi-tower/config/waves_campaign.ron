// GIOCHI Tower Defense — campanha, 6 ondas (GDD §5).
//
// `peak_alive` é do documento. A composição (quantos de cada tipo) é escolha de
// design: o GDD fixa o pico vivo e a duração, não o total de spawns.
// `combat_s` 360 + `shop_s` 60 = 7 min por ciclo × 6 = 42 min (GDD §4).
(
    mode: Campaign,
    wave_count: 6,
    combat_s: 360.0,
    shop_s: 60.0,
    warmup_s: 5.0,

    waves: [
        // Onda 1 — tutorial implícito; o nemesis spawna aqui (GDD §10).
        (
            number: 1,
            peak_alive: 30,
            boss: None,
            spawns: [
                (kind: Grunt, count: 60, interval_s: 2.5),
            ],
        ),
        // Onda 2 — introduz Ranged e Flying (GDD §5).
        (
            number: 2,
            peak_alive: 50,
            boss: None,
            spawns: [
                (kind: Grunt, count: 70, interval_s: 1.8),
                (kind: Ranged, count: 25, interval_s: 4.0),
                (kind: Flying, count: 15, interval_s: 5.0),
            ],
        ),
        // Onda 3 — Tanker Bug.
        (
            number: 3,
            peak_alive: 60,
            boss: Some(Tanker),
            spawns: [
                (kind: Grunt, count: 70, interval_s: 1.6),
                (kind: Tank, count: 12, interval_s: 12.0),
                (kind: Ranged, count: 20, interval_s: 4.0),
                (kind: Flying, count: 10, interval_s: 6.0),
            ],
        ),
        // Onda 4 — Plasma Bug.
        (
            number: 4,
            peak_alive: 80,
            boss: Some(Plasma),
            spawns: [
                (kind: Grunt, count: 80, interval_s: 1.4),
                (kind: Tank, count: 14, interval_s: 10.0),
                (kind: Ranged, count: 30, interval_s: 3.0),
                (kind: Flying, count: 20, interval_s: 4.0),
            ],
        ),
        // Onda 5 — Brain Bug, e o Swarm coordenado (GDD §5).
        (
            number: 5,
            peak_alive: 100,
            boss: Some(Brain),
            spawns: [
                (kind: Grunt, count: 80, interval_s: 1.2),
                (kind: Tank, count: 16, interval_s: 9.0),
                (kind: Ranged, count: 30, interval_s: 3.0),
                (kind: Flying, count: 20, interval_s: 3.5),
                (kind: Swarm, count: 40, interval_s: 0.6),
            ],
        ),
        // Onda 6 — Queen, final da campanha.
        (
            number: 6,
            peak_alive: 120,
            boss: Some(Queen),
            spawns: [
                (kind: Grunt, count: 90, interval_s: 1.1),
                (kind: Tank, count: 20, interval_s: 8.0),
                (kind: Ranged, count: 35, interval_s: 2.6),
                (kind: Flying, count: 25, interval_s: 3.0),
                (kind: Swarm, count: 60, interval_s: 0.5),
            ],
        ),
    ],
)
