// GIOCHI Tower Defense — os quatro bosses (GDD §9).
//
// HP, danos e recompensas são os do documento. Raio/período de stomp, distância
// de teleporte e raio de buff são escolhas de implementação (DECISIONS.md, D-012).
(
    bosses: [
        // §9.1 — Tanker Bug, onda 3.
        (
            id: Tanker,
            wave: 3,
            hp: 2500.0,
            damage_melee: 40.0,
            damage_projectile: 0.0,
            speed_mps: 1.0,
            stomp_radius_m: Some(3.0),
            stomp_period_s: Some(15.0),
            knockback_immune: true,
            gold_reward: 50,
            score_reward: 500,
        ),

        // §9.2 — Plasma Bug, onda 4: atira de longe e teleporta 5 m.
        (
            id: Plasma,
            wave: 4,
            hp: 2000.0,
            damage_melee: 0.0,
            damage_projectile: 30.0,
            speed_mps: 1.4,
            teleport_distance_m: Some(5.0),
            teleport_trigger_m: Some(6.0),
            keeps_distance_m: Some(12.0),
            knockback_immune: false,
            gold_reward: 50,
            score_reward: 500,
        ),

        // §9.3 — Brain Bug, onda 5: invoca 4 adds a cada 20 s e bufa aliados.
        (
            id: Brain,
            wave: 5,
            hp: 3000.0,
            damage_melee: 20.0,
            damage_projectile: 0.0,
            speed_mps: 1.2,
            summon_count: Some(4),
            summon_period_s: Some(20.0),
            buff_damage_pct: Some(30.0),
            buff_radius_m: Some(8.0),
            knockback_immune: false,
            gold_reward: 50,
            score_reward: 500,
        ),

        // §9.4 — Queen, onda 6: três fases, 100-60 / 60-30 / 30-0.
        (
            id: Queen,
            wave: 6,
            hp: 6000.0,
            damage_melee: 60.0,
            damage_projectile: 25.0,
            speed_mps: 1.3,
            stomp_radius_m: Some(4.0),
            stomp_period_s: Some(8.0),
            knockback_immune: true,
            gold_reward: 200,
            score_reward: 2000,
            phases: [
                // Fase 1: spawna filhotes a cada 10 s, slam AoE.
                (
                    from_hp_pct: 100.0,
                    to_hp_pct: 60.0,
                    speed_multiplier: 1.0,
                    slam_double: false,
                    projectile_fan: 0,
                    summon_period_s: 10.0,
                    summon_count: 3,
                ),
                // Fase 2: projéteis em leque, filhotes mais rápidos.
                (
                    from_hp_pct: 60.0,
                    to_hp_pct: 30.0,
                    speed_multiplier: 1.15,
                    slam_double: false,
                    projectile_fan: 5,
                    summon_period_s: 10.0,
                    summon_count: 3,
                ),
                // Fase 3: enrage, velocidade +50%, slam duplo.
                (
                    from_hp_pct: 30.0,
                    to_hp_pct: 0.0,
                    speed_multiplier: 1.5,
                    slam_double: true,
                    projectile_fan: 7,
                    summon_period_s: 8.0,
                    summon_count: 4,
                ),
            ],
        ),
    ],
)
