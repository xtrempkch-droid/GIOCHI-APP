// GIOCHI Tower Defense — perfis de host (GDD §16).
//
// RK3326 é CLIENTE por padrão (`default_role: Client`); o perfil Rk3326 existe
// para o caso de emergência em que ele precise hospedar.
(
    default: Balanced,
    default_role: Client,

    profiles: [
        // RK3566/RK3588/PC ARM64.
        (
            id: Full,
            label: "Full",
            max_enemies: 150,
            ai_hz: 20,
            pathfinding: AStarGrid,
            aoi_scale: 1.5,
            vfx_level: Full,
        ),
        // Intermediário.
        (
            id: Balanced,
            label: "Balanced",
            max_enemies: 100,
            ai_hz: 15,
            pathfinding: AStarCached,
            aoi_scale: 1.5,
            vfx_level: Reduced,
        ),
        // RK3326 1 GB — host de emergência: 40-50 inimigos, steering, 10-15 Hz,
        // AOI agressiva e VFX mínimos.
        (
            id: Rk3326,
            label: "RK3326 (emergência)",
            max_enemies: 45,
            ai_hz: 12,
            pathfinding: Steering,
            aoi_scale: 1.0,
            vfx_level: Minimal,
        ),
    ],
)
